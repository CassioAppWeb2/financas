# =====================================================================
# Variáveis das FUNÇÕES DE SERVIDOR (Supabase → Edge Functions → Secrets)
# Nunca coloque estas chaves no navegador nem no repositório.
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são
# fornecidas automaticamente pelo Supabase às funções.
# =====================================================================

# --- IA (opcional: sem ela o app funciona com o interpretador por regras) ---
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opcional: transcrição de áudio gratuita e rápida (console.groq.com)
GROQ_API_KEY=

# Alternativa paga (Whisper para áudio). Se definida e sem Gemini, é usada.
OPENAI_API_KEY=
# gemini | openai  (fornecedor de transcrição de áudio)
STT_PROVIDER=gemini

# --- WhatsApp Business Cloud API (Fase 3) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que você inventa e repete no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=
# "Chave secreta do app" no painel da Meta (valida que a chamada veio da Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Trava de custo: máximo de respostas por mês (a Meta dá 1.000 grátis por número)
WHATSAPP_MONTHLY_LIMIT=950

# --- Telegram (gratuito, sem limite) ---
# Token entregue pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Texto que você inventa (letras, números, _ e -); usado ao registrar o webhook
TELEGRAM_WEBHOOK_SECRET=

# =====================================================================
# Variáveis do APLICATIVO (públicas) ficam em web/js/config.js:
#   SUPABASE_URL, SUPABASE_ANON_KEY (chave pública), WHATSAPP_NUMBER, TELEGRAM_BOT
# =====================================================================

# Somente para testes locais
LOCAL_DB_URL=postgres://postgres@127.0.0.1:54329/financas
